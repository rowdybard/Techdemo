// Cloudflare deployment: the "techdemo" Worker (it serves skygreeting.com). Static files
// are assets; worker/index.js runs for /api/* (checkout, greetings, reports) and the home
// page (link previews).
// Every `wrangler deploy` (locally or in Cloudflare's Git builds) first runs the build
// command, which copies every top-level page (*.html, so a new page goes live by existing), src/ and
// vendor/ into .deploy/, and uploads only that folder
// as assets, so dev tooling (node_modules, tools/, screenshots, .git) never goes live.
// Secrets (STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET) live in the Cloudflare dashboard.
{
  "name": "techdemo",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-30",
  "build": { "command": "node tools/deploy-stage.mjs" },
  // The worker answers /api/* and the home page (to fill in link previews for greetings).
  "assets": { "directory": "./.deploy", "binding": "ASSETS", "run_worker_first": ["/api/*", "/", "/index.html", "/autoshow", "/autoshow/", "/*.html", "/about", "/about/", "/ideas", "/ideas/", "/birthday-fireworks", "/birthday-fireworks/", "/love-you-fireworks", "/love-you-fireworks/", "/congratulations-fireworks", "/congratulations-fireworks/", "/thank-you-fireworks", "/thank-you-fireworks/", "/halloween-fireworks-ecard", "/halloween-fireworks-ecard/", "/new-years-eve-virtual-fireworks", "/new-years-eve-virtual-fireworks/", "/name-in-fireworks", "/name-in-fireworks/", "/silent-fireworks", "/silent-fireworks/", "/gift-for-someone-who-has-everything", "/gift-for-someone-who-has-everything/"] },
  "kv_namespaces": [{ "binding": "GREETINGS", "id": "ce11e2e797df435582f3725b943b236b" }],
  "durable_objects": { "bindings": [{ "name": "GUARDS", "class_name": "GreetingGuard" }] },
  // This LOCAL migration definition runs only when an approved deployment is made.
  "migrations": [{ "tag": "greeting-guards-v1", "new_sqlite_classes": ["GreetingGuard"] }],
  // Normal price remains $4.99. The launch offer ($1.99 for exactly 30 days) started when the
  // owner merged this release; it ends 2026-11-09T03:57:00Z by itself. Never change or reset this start.
  "vars": { "DELUXE_LAUNCH_START_UTC": "2026-10-10T03:57:00Z" },
  // Variables added in the dashboard survive deploys (secrets always do).
  "keep_vars": true,
  "observability": { "enabled": true }
}
