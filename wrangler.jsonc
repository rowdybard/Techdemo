// Cloudflare deployment: the "techdemo" Worker (it serves skygreeting.com). Static files
// are assets; worker/index.js runs only for /api/* (Stripe checkout and greetings).
// Every `wrangler deploy` (locally or in Cloudflare's Git builds) first runs the build
// command, which copies index.html and src/ into .deploy/, and uploads only that folder
// as assets, so dev tooling (node_modules, tools/, screenshots, .git) never goes live.
// Secrets (STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET) live in the Cloudflare dashboard.
{
  "name": "techdemo",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-30",
  "build": { "command": "rm -rf .deploy && mkdir .deploy && cp -r index.html src .deploy/" },
  "assets": { "directory": "./.deploy", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "kv_namespaces": [{ "binding": "GREETINGS", "id": "ce11e2e797df435582f3725b943b236b" }],
  // Deluxe price in cents. $1 while testing with real cards; 499 when it goes on sale.
  "vars": { "DELUXE_PRICE_CENTS": "100" },
  // Variables added in the dashboard survive deploys (secrets always do).
  "keep_vars": true,
  "observability": { "enabled": true }
}
