# Cloudflare static-asset headers. Pages and code (src/) have no rule here, so they get
# Cloudflare's default, "public, max-age=0, must-revalidate" with an ETag: an unchanged file
# costs a quick 304, and after a deploy no phone can pair the new page with old scripts it
# kept. (A five-minute rule for src/ did exactly that: the new page's round icons with the old
# "Lock view" label and no sound button.) Don't add a src/* rule back: it would also be joined
# onto the og/ rule below, since Cloudflare joins every matching rule's values with a comma.
# vendor/ holds exact library versions whose paths change with the version, so they are cached
# for a year.
/src/og/*
  Cache-Control: public, max-age=86400
/vendor/*
  Cache-Control: public, max-age=31536000, immutable
/icons/*
  Cache-Control: public, max-age=86400
/favicon.*
  Cache-Control: public, max-age=86400
